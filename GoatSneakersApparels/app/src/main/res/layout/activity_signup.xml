<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@android:color/white"
    android:focusableInTouchMode="true">

    <!-- Goat Logo ImageView -->
    <ImageView
        android:id="@+id/ivGoatLogo1"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/app_logo"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="24dp"
        android:contentDescription="@string/goat_logo_desc"/>

    <!-- Sign Up Title (Centered) -->
    <TextView
        android:id="@+id/tvSignUpTitle1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sign_up_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:layout_below="@id/ivGoatLogo1"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"/>

    <!-- Close Button -->
    <TextView
        android:id="@+id/tvCloseButton1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/close"
        android:textColor="@android:color/black"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="16dp"
        android:textSize="14sp"
        android:padding="10dp"
        android:clickable="true"/>

    <!-- First & Last Name -->
    <EditText
        android:id="@+id/etFirstLastName1"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="@string/first_last_name"
        android:background="@android:color/transparent"
        android:textColor="@android:color/black"
        android:textColorHint="@android:color/darker_gray"
        android:textSize="14sp"
        android:inputType="textPersonName"
        android:layout_below="@+id/tvSignUpTitle1"
        android:layout_marginTop="24dp"
        android:paddingBottom="8dp"
        android:singleLine="true"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/black"
        android:layout_below="@+id/etFirstLastName1"
        android:layout_marginTop="8dp"/>

    <!-- Email Address -->
    <EditText
        android:id="@+id/etEmailAddress1"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="@string/email_address"
        android:background="@android:color/transparent"
        android:textColor="@android:color/black"
        android:textColorHint="@android:color/darker_gray"
        android:textSize="14sp"
        android:inputType="textEmailAddress"
        android:layout_below="@+id/etFirstLastName1"
        android:layout_marginTop="16dp"
        android:paddingBottom="8dp"
        android:singleLine="true"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/black"
        android:layout_below="@+id/etEmailAddress1"
        android:layout_marginTop="8dp"/>

    <!-- Password (8+ Characters) -->
    <EditText
        android:id="@+id/etPasswordField1"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="@string/password"
        android:background="@android:color/transparent"
        android:textColor="@android:color/black"
        android:textColorHint="@android:color/darker_gray"
        android:textSize="14sp"
        android:inputType="textPassword"
        android:layout_below="@+id/etEmailAddress1"
        android:layout_marginTop="24dp"
        android:paddingBottom="8dp"
        android:singleLine="true"/>

    <!-- Show/Hide Password -->

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/black"
        android:layout_below="@+id/etPasswordField1"
        android:layout_marginTop="8dp"/>

    <!-- Sign up for exclusive promos checkbox -->
    <CheckBox
        android:id="@+id/cbPromosCheckbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/promo_signup"
        android:textColor="@android:color/black"
        android:textSize="12sp"
        android:layout_below="@+id/etPasswordField1"
        android:layout_marginTop="16dp"/>

    <!-- Sign Up Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSignUpAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sign_up"
        android:textAllCaps="false"
        android:layout_below="@+id/cbPromosCheckbox"
        android:layout_marginTop="24dp"
        android:layout_margin="12dp"
        android:layout_marginBottom="16dp"
        android:padding="16dp"
        android:layout_centerHorizontal="true"
        style="@style/CustomButtonStyle"/>

    <!-- Privacy Policy and Terms of Service -->
    <TextView
        android:id="@+id/tvPrivacyTerms1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/privacy_terms"
        android:textColor="@android:color/darker_gray"
        android:textSize="14sp"
        android:layout_centerHorizontal="true"
        android:layout_below="@+id/btnSignUpAction"
        android:layout_marginTop="16dp"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/loginRedirectText1"
        android:text="Already an user? Login"
        android:layout_gravity="center"
        android:padding="8dp"
        android:layout_marginTop="8dp"
        android:textSize="18sp"
        android:textColor="@color/black"/>

</RelativeLayout>
